# =============================================================================
# DocExtract Pro - AI-Powered Invoice & ERP Automation Platform
# Configuration template. Copy to ".env" in this folder and fill in your values:
#     cp .env.example .env          (Windows: copy .env.example .env)
# The same file is used by Docker Compose and by the local development server.
# NEVER commit .env. Values left as "replace_with_..." are treated as NOT SET.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime mode: "production" enforces strong secrets and secure cookies.
# Use "development" for local work with the Flask dev server.
# -----------------------------------------------------------------------------
FLASK_ENV=production
PORT=5000

# -----------------------------------------------------------------------------
# AI extraction (recommended). All AI calls are made by the backend only.
# AI_PROVIDER: auto | openai | gemini | groq | openrouter | none
#   auto = the first of OpenAI, Gemini, Groq, OpenRouter that has a key set,
#          else local rule-based parsing only (works with no key at all).
# No paid key yet? Use the FREE Google Gemini key below (vision + JSON schema).
# -----------------------------------------------------------------------------
AI_PROVIDER=auto

# Official OpenAI API - create a key at https://platform.openai.com/api-keys
# (the account needs billing/credit enabled). Use a model your project can access.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Optional: only for OpenAI-compatible gateways/proxies, or org/project scoping
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# FREE: Google Gemini - create a key at https://aistudio.google.com/apikey
# (Google account only, no card). Free tier has per-minute/day limits, and
# Google may use free-tier data to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried when the main model is busy or retired
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# FREE: Groq - create a key at https://console.groq.com/keys
# Fast text extraction; the default model cannot read images (no vision fallback).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative: OpenRouter (https://openrouter.ai/keys).
# Models ending in ":free" cost nothing but are rate limited and change often.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Comma-separated models to try if the primary OpenRouter model fails
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Invoice ERP Automation

# Request behaviour
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=24000
# When OCR is unavailable or finds no text, send the page image(s) to the AI
# model instead (requires a vision-capable model such as gpt-4o-mini).
AI_VISION_FALLBACK=true
AI_VISION_MAX_PAGES=3

# -----------------------------------------------------------------------------
# Login (single administrator account) - REQUIRED in production
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=replace_with_64_hex_characters_from_the_command_above
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace_with_a_strong_password_min_12_chars
# Optional machine-to-machine access (X-API-Key header). Leave empty to disable.
API_SECRET_KEY=

# Session cookies. Secure cookies need HTTPS (browsers also accept them on
# http://localhost). Set false ONLY for plain-HTTP access on a trusted LAN.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=24

# Browser origins allowed to call the API with credentials (comma-separated, no *).
# Not needed when the UI and API are served from the same origin (Docker setup).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Reverse proxy & rate limiting
# -----------------------------------------------------------------------------
# Number of proxies in front of the backend that set X-Forwarded-For.
# Docker Compose sets 1 (its nginx). Add one per extra proxy/load balancer.
TRUSTED_PROXIES_COUNT=0
LOGIN_RATE_LIMIT=5 per 5 minutes
# memory:// is fine for one backend process. Use redis://host:6379/0 when
# running several workers or replicas.
RATE_LIMIT_STORAGE_URI=memory://

# -----------------------------------------------------------------------------
# Uploads, PDFs and OCR
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=16777216
MAX_PDF_PAGES=20
PDF_RENDER_DPI=150
PDF_TEXT_LAYER_MIN_CHARS=40
# Load OCR models at startup (slower boot, faster first upload)
OCR_PRELOAD=true
# Which local OCR engines to load: paddleocr, easyocr (comma-separated)
OCR_ENGINES=paddleocr,easyocr

# -----------------------------------------------------------------------------
# Database (SQLite). Docker overrides this to /app/data/invoices.db.
# Relative paths are resolved from the directory the server is started in.
# -----------------------------------------------------------------------------
DATABASE_PATH=backend/data/invoices.db

# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API (optional)
# Requires a Meta developer app with the WhatsApp product and a public HTTPS URL.
# -----------------------------------------------------------------------------
# App secret (App settings > Basic) - verifies X-Hub-Signature-256 on webhooks
WHATSAPP_APP_SECRET=replace_with_meta_app_secret
# Any random string; enter the same value in the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_verify_token
# Permanent/system-user access token - needed to download media and send replies
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_SEND_REPLIES=true
# In-app simulator (processes an upload as if it came from WhatsApp; sends nothing)
WHATSAPP_SIMULATOR_ENABLED=true

# -----------------------------------------------------------------------------
# ERP integrations (optional)
# -----------------------------------------------------------------------------
# Tally XML server. Only this exact URL can be used. From Docker, use
# http://host.docker.internal:9000 when Tally runs on the same PC.
PERMITTED_TALLY_URL=http://localhost:9000
TALLY_COMPANY_NAME=
TALLY_PURCHASE_LEDGER=Purchase Account
TALLY_CGST_LEDGER=Input CGST
TALLY_SGST_LEDGER=Input SGST
TALLY_IGST_LEDGER=Input IGST
TALLY_ROUND_OFF_LEDGER=Round Off
TALLY_INCLUDE_INVENTORY=false

# Custom ERP REST endpoint (public HTTPS). The key is sent as "Authorization: Bearer"
# and only to this configured endpoint.
CUSTOM_ERP_ENDPOINT=
CUSTOM_ERP_API_KEY=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Docker sets LOG_TO_FILE=false (logs go to `docker compose logs`)
LOG_TO_FILE=true

# -----------------------------------------------------------------------------
# Docker Compose only
# -----------------------------------------------------------------------------
HTTP_PORT=8080
HTTP_BIND=0.0.0.0
# Set false for a much smaller image without local OCR (needs an AI key for scans)
INSTALL_OCR=true
