# ==============================================================================
# AI-Powered Invoice & ERP Automation Platform - Environment Configuration Template
# Copy this file to backend/.env and replace placeholder values.
# NEVER commit backend/.env or disclose actual secrets.
# ==============================================================================

# LLM Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# Server Environment ('development' or 'production')
FLASK_ENV=development
PORT=5000

# CORS Allowed Origins (Comma-separated origins; NO wildcards permitted with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Permitted Local Tally URL (Strict loopback endpoint for accounting vouchers)
PERMITTED_TALLY_URL=http://localhost:9000

# Maximum File Upload Size in Bytes (Default: 16777216 = 16 MiB)
MAX_UPLOAD_SIZE_BYTES=16777216

# PDF Processing Limits
MAX_PDF_PAGES=20
PDF_RENDER_DPI=150

# ------------------------------------------------------------------------------
# Authentication & Session Security (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_chars

# Application Admin Credentials (Used for browser session authentication)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace_with_a_strong_password_min_12_chars

# Programmatic API Secret Key (Used for machine-to-machine / testing headers)
API_SECRET_KEY=replace_with_machine_api_secret_key_min_32_chars

# Session Cookie Security Flags
# Set to 'true' in production (requires HTTPS), 'false' in local HTTP development
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=24

# ------------------------------------------------------------------------------
# Meta / WhatsApp Business Cloud API Webhook Security (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Meta App Secret (Used to verify X-Hub-Signature-256 HMAC-SHA256 signature on POST)
WHATSAPP_APP_SECRET=replace_with_meta_app_secret_from_app_dashboard

# Verification Token (Used for GET challenge verification when registering webhook)
WHATSAPP_VERIFY_TOKEN=replace_with_random_verify_token_configured_in_meta_dashboard
