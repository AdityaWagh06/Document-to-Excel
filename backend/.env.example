# LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/auto

# Server & Security
FLASK_ENV=development
PORT=5000

# CORS Allowed Origins (comma-separated list of trusted client origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Permitted Local Tally URL (Restricted loopback destination for accounting sync)
PERMITTED_TALLY_URL=http://localhost:9000

# Maximum File Upload Size in Bytes (Default: 16777216 = 16 MiB)
MAX_UPLOAD_SIZE_BYTES=16777216

# PDF Processing Limits
MAX_PDF_PAGES=20
PDF_RENDER_DPI=150

# WhatsApp Cloud API Webhook Verify Token
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
