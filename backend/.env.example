# The configuration template now lives at the project root: ../.env.example
# Copy it to ".env" in the project root (recommended) or to "backend/.env".
# If both exist, both are read and values in backend/.env win.
#
# Minimal local-development example:
FLASK_ENV=development
SESSION_COOKIE_SECURE=false
# Paid OpenAI key, or leave it empty and set a FREE Gemini key
# from https://aistudio.google.com/apikey
OPENAI_API_KEY=
GEMINI_API_KEY=
